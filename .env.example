# Supabase Configuration
# These two are required. The app reads EXPO_PUBLIC_SUPABASE_URL and
# EXPO_PUBLIC_SUPABASE_ANON_KEY (see utils/supabase.ts).
EXPO_PUBLIC_SUPABASE_URL=your_supabase_project_url_here
EXPO_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Optional: For production, you might want to use service role key for backend operations
# NOTE: never expose this to the client — do not prefix it with EXPO_PUBLIC_.
# SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Application Configuration
NODE_ENV=development
PORT=3000 (if using a backend server)

# Feature Flags
ENABLE_EMAIL_VERIFICATION=true
ENABLE_RATE_LIMITING=true
ENABLE_MFA_PREPARATION=true